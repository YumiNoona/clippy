# Vercel Project Settings > Environment Variables.
# Get these from a writable Upstash Redis database (or its Vercel integration).
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-server-only-token
# Keep previews separate from your production clipboard database.
LOOP_REDIS_NAMESPACE=loop-production
# Shared spaces expire after 30 days without a successful sync.
LOOP_SPACE_TTL_SECONDS=2592000
